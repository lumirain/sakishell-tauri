{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "SakiShell",
  "identifier": "com.sakishell.app",
  "version": "1.0.4",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --mode development",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SakiShell",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/marcel-previews/**/*",
          "$APPCONFIG/images/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "bannerPath": "icons/wix-banner.png",
        "dialogImagePath": "icons/wix-dialog.png"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp"
      }
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENjk4MEVCOTA5MUZFQzgKUldUSS9wR1E2NEJwTGU5WVI3QnJNL1pRb3IvalJsTWpxNitFVkIza0dPV2VNZ0doSEZldk8vdkkK",
      "endpoints": [
        "https://raw.githubusercontent.com/lumirain/sakishell-tauri/main/latest.json"
      ]
    }
  }
}
